classDiagram

    class UserProfile {
        +String genre
        +String mood
        +float target_energy
        +float target_tempo
        +float target_valence
        +float target_danceability
        +float target_acousticness
    }

    class Song {
        +String title
        +String artist
        +String genre
        +String mood
        +float energy
        +float tempo
        +float valence
        +float danceability
        +float acousticness
    }

    class SimilarityScorer {
        +calculate_score(user, song)
        +compare_features()
        +generate_explanation()
    }

    class Playlist {
        +recommend_songs(songs, user, number_of_songs)
        +generate_mood_playlist(songs, mood, number_of_songs)
    }

    class TrackFeatures {
        +load_songs(csv_path)
        +generate_mood(energy, valence, acousticness)
    }

    class HTMLOutput {
        +create_playlist_html(recommendations, filename)
    }

    class Main {
        +main()
    }

    Main --> TrackFeatures : loads songs
    Main --> UserProfile : creates profile
    Main --> Playlist : generates playlist
    TrackFeatures --> Song : creates song objects
    UserProfile --> SimilarityScorer : provides preferences
    Song --> SimilarityScorer : provides features
    SimilarityScorer --> Playlist : calculates recommendations
    Playlist --> HTMLOutput : sends recommendations
    HTMLOutput --> Song : displays song information